{
  "name": "linebot",
  "version": "0.1.0",
  "description": "Cloudflare Workers + Hono で動く、日本語⇔台湾華語(繁体字)翻訳 LINE Bot",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/shmokmt/linebot"
  },
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --minify",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "mock:event": "node scripts/send-mock-event.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "hono": "^4.13.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260928.1",
    "typescript": "^5.9.2",
    "wrangler": "^4.142.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260911.1": true,
    "fsevents@2.3.3": true
  }
}
