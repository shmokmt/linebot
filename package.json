{
  "name": "linebot",
  "version": "0.1.0",
  "description": "Cloudflare Workers + Hono で動く、日本語⇔台湾華語(繁体字)翻訳 LINE Bot",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/shmokmt/linebot"
  },
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "cf dev",
    "deploy": "cf deploy",
    "build": "cf build",
    "cf-typegen": "cf workers types",
    "mock:event": "node scripts/send-mock-event.mjs",
    "typecheck": "cf workers types && tsc --noEmit"
  },
  "dependencies": {
    "hono": "^4.13.7"
  },
  "devDependencies": {
    "cf": "^1.0.0-beta.6",
    "typescript": "^5.9.2",
    "wrangler": "^4.144.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260911.1": true,
    "fsevents@2.3.3": true
  }
}
